# -----------------------------------------------------------------------------
# Palworld Docker Compose configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and change ADMIN_PASSWORD before first deployment.
# Values containing spaces or special characters should be single-quoted.

# Container image and host identity
PALWORLD_IMAGE_TAG=2.5.0
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Persistent game data directory, relative to the deployment directory.
# Keep the ./ prefix. Absolute paths, .., spaces, and symlinks are rejected.
PALWORLD_DATA_DIR=./palworld

# Network
PALWORLD_BIND_IP=0.0.0.0
PALWORLD_PORT=8211
QUERY_PORT=27015

# The REST API is intentionally accessible only from the Docker host.
REST_API_ENABLED=true
REST_API_BIND_IP=127.0.0.1
REST_API_PORT=8212

# Server identity and access
SERVER_NAME='My Palworld Server'
SERVER_DESCRIPTION='Private Palworld dedicated server'
SERVER_PASSWORD=
ADMIN_PASSWORD=change-this-password
PLAYERS=8
COMMUNITY=false
PUBLIC_IP=
PUBLIC_PORT=
CROSSPLAY_PLATFORMS='(Steam,Xbox,PS5,Mac)'

# Installation and performance
UPDATE_ON_BOOT=true
MULTITHREADING=false
ENABLE_PERF_THREADING_ARGS=false
WORKER_THREADS_SERVER=

# Player/API monitoring
ENABLE_PLAYER_LOGGING=true
PLAYER_LOGGING_POLL_PERIOD=5

# Backups: every day at 03:00, retain for 30 days
BACKUP_ENABLED=true
BACKUP_CRON_EXPRESSION='0 3 * * *'
DELETE_OLD_BACKUPS=true
OLD_BACKUP_DAYS=30

# Automatic game updates and scheduled reboots are disabled by default
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_CRON_EXPRESSION='0 4 * * *'
AUTO_UPDATE_WARN_MINUTES=30
AUTO_REBOOT_ENABLED=false
AUTO_REBOOT_CRON_EXPRESSION='0 5 * * *'
AUTO_REBOOT_WARN_MINUTES=5
AUTO_REBOOT_EVEN_IF_PLAYERS_ONLINE=false

# Container logs
LOG_LEVEL=INFO
LOG_FORMAT_TYPE=default
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# Frequently adjusted world settings
DIFFICULTY=None
DAYTIME_SPEEDRATE=1.000000
NIGHTTIME_SPEEDRATE=1.000000
EXP_RATE=1.000000
PAL_CAPTURE_RATE=1.000000
PAL_SPAWN_NUM_RATE=1.000000
PAL_DAMAGE_RATE_ATTACK=1.000000
PAL_DAMAGE_RATE_DEFENSE=1.000000
PLAYER_DAMAGE_RATE_ATTACK=1.000000
PLAYER_DAMAGE_RATE_DEFENSE=1.000000
COLLECTION_DROP_RATE=1.000000
COLLECTION_OBJECT_RESPAWN_SPEED_RATE=1.000000
ENEMY_DROP_ITEM_RATE=1.000000
DEATH_PENALTY=Item
PAL_EGG_DEFAULT_HATCHING_TIME=1.000000
WORK_SPEED_RATE=1.000000
BASE_CAMP_WORKER_MAX_NUM=15
BASE_CAMP_MAX_NUM_IN_GUILD=4
GUILD_PLAYER_MAX_NUM=20
AUTO_SAVE_SPAN=30.000000
IS_PVP=false
ENABLE_FRIENDLY_FIRE=false
ENABLE_FAST_TRAVEL=true
ALLOW_CLIENT_MOD=true
